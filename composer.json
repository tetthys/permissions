    "illuminate/contracts": "Required for Laravel integration",
    "illuminate/database": "Required for Laravel DB PermissionStore"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tetthys\\Permissions\\Integration\\Laravel\\LaravelPermissionServiceProvider"
      ]
    }
  }
}
